{
  "schema_version": "1.0",
  "tool": "lastwinscli",
  "command": ["./lastwinscli"],
  "timeout_seconds": 5,
  "argument_order": { "command_path": ["list"], "local_args": ["--limit", "5"], "global_flag": "--format", "value": "json", "alternate_value": "plain" },
  "probes": [
    { "name": "list", "argv": ["list"], "kind": "read" }
  ]
}
